DNS_DOMAIN=localhost
# Keycloak client for the /appeal login. Must match the client TripBot redeems
# the code with (KEYCLOAK_BAN_APPEALS_CLIENT_ID). Read when `next dev` starts or
# `next build` runs, not by a running production container.
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=

# Staff appeal review: server-only runtime settings. See docs/staff-appeal-review.md.
# Use a separate confidential Keycloak client; keep the /appeal public client above.
STAFF_SITE_ORIGIN=
STAFF_KEYCLOAK_ISSUER=
STAFF_KEYCLOAK_CLIENT_ID=
STAFF_KEYCLOAK_CLIENT_SECRET=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STAFF_COOKIE_SECRET=
# TripBot server origin, without /api/v2.
TRIPBOT_API_URL=
