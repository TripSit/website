{
  "permissions": {
    "allow": [
      "Bash(npm run sonar:precheck*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -Eq '\"command\"[[:space:]]*:[[:space:]]*\"[^\"]*(^|[;&|[:space:]])gh[[:space:]]+pr[[:space:]]+create' || exit 0; bash \"$CLAUDE_PROJECT_DIR/scripts/sonar-precheck.sh\" || exit 2",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
