{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "## DOCKER ##": "",
    "website": "docker compose --file docker-compose.website.yml --project-name website up -d --force-recreate --build website",
    "logs": "docker container logs website -f -n 100",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:lint": "docker exec -it website npm run lint",
    "docker:lint:fix": "docker exec -it website npm run lint:fix",
    "## LOCAL/CODESPACE ##": "",
    "dev": "set NODE_OPTIONS=--inspect && next dev",
    ".dev": "NODE_OPTIONS=--inspect next dev",
    ".lint": "eslint .",
    ".start": "next start",
    "prepare": "husky",
    "lint-staged": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix"
    ]
  },
  "overrides": {
    "@babel/helper-plugin-utils": "7.26.5"
  },
  "engines": {
    "node": ">=23.9.0 || >=22.14.0",
    "npm": ">=10.9.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroui/react": "^2.8.10",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@widgetbot/react-embed": "^1.11.3",
    "aos": "^2.3.4",
    "apexcharts": "^5.16.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "discord-api-types": "^0.38.49",
    "kofi-button": "^1.1.1",
    "material-react-table": "^3.2.1",
    "next": "^16.2.10",
    "particles-bg": "^2.5.5",
    "react": "^19.2.7",
    "react-apexcharts": "^2.1.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.7",
    "swiper": "^14.0.5",
    "tailwindcss": "^4.3.2",
    "tripsit_drug_db": "github:tripsit/drugs",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/aos": "^3.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.67.0"
  }
}
