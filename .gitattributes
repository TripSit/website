# Normalize text files to LF and let Git detect binary files, instead of
# forcing every file to be treated as text.
* text=auto eol=lf

# Never apply line-ending conversion to these. Stripping CR bytes from fonts
# or images corrupts them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
